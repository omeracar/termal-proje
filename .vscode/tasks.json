{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend + Frontend",
      "dependsOn": ["Backend", "Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "windows": {
        "options": {
          "env": {
            "PATH": "${workspaceFolder}/backend/venv/Scripts;${env:PATH}"
          }
        }
      },
      "osx": {
        "options": {
          "env": {
            "PATH": "${workspaceFolder}/backend/venv/bin:${env:PATH}"
          }
        }
      },
      "linux": {
        "options": {
          "env": {
            "PATH": "${workspaceFolder}/backend/venv/bin:${env:PATH}"
          }
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    }
  ]
}